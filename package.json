{
  "name": "fishe-haraj-pos",
  "private": true,
  "version": "1.0.9",
  "description": "نظام حراج الأسماك - نقطة البيع والحسابات",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/patch-html2canvas.js && vite build && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:@prisma/client --sourcemap --outfile=dist/server.cjs",
    "postbuild": "node scripts/post-build-sync.js",
    "postinstall": "node scripts/patch-html2canvas.js",
    "electron:dev": "concurrently -k -s first \"cross-env NODE_ENV=development PORT=3100 tsx server.ts\" \"wait-on -t 30000 http-get://127.0.0.1:3100/api/ping && cross-env NODE_ENV=development FISHE_DEV_SERVER_PORT=3100 electron .\"",
    "electron:start": "electron .",
    "electron:build": "npm run build && node -e \"try{require('fs').rmSync('release/win-unpacked',{recursive:true,force:true,maxRetries:10,retryDelay:500})}catch(e){}\" && electron-builder --win && node scripts/post-build-sync.js",
    "electron:portable": "npm run build && electron-builder --win portable --dir && node scripts/post-build-sync.js",
    "electron:dist": "npm run build && node -e \"try{require('fs').rmSync('release/win-unpacked',{recursive:true,force:true,maxRetries:10,retryDelay:500})}catch(e){}\" && electron-builder --win --x64 && node scripts/post-build-sync.js",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "sync": "node scripts/post-build-sync.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@babel/types": "^8.0.4",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^29.4.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.fishe.harajpos",
    "productName": "نظام حراج الأسماك",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "prisma/**/*",
      ".env",
      "package.json",
      {
        "from": "node_modules/.prisma",
        "to": "node_modules/.prisma"
      },
      {
        "from": "node_modules/@prisma",
        "to": "node_modules/@prisma"
      }
    ],
    "win": {
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام حراج الأسماك"
    }
  }
}
